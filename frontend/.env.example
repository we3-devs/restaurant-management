BACKEND_INTERNAL_URL=http://127.0.0.1:3001
# Browser-reachable backend origin, used only for the KDS websocket
# connection (the browser can't reach BACKEND_INTERNAL_URL's docker/internal
# hostname, and all other traffic already goes through /api/backend).
NEXT_PUBLIC_BACKEND_WS_URL=http://127.0.0.1:3001
