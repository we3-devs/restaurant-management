# Server-side backend URL used by the Next.js proxy
BACKEND_INTERNAL_URL=http://127.0.0.1:3001
# atithi.restra.localhost in development; atithi.restra.com in production
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=restra.localhost
# Preview-only escape hatch; leave unset/false on the production staff project.
ALLOW_NON_TENANT_HOSTS=false
# Keep staff cookies host-only; never use .restra.com.
AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_BACKEND_WS_URL=http://127.0.0.1:3001

# Local app URLs. Production should route dashboard and operational through
# one staff.{tenant}.restra.com deployment.
OPERATIONAL_WEB_URL=http://localhost:3100
NEXT_PUBLIC_OPERATIONAL_WEB_URL=http://localhost:3100
NEXT_PUBLIC_GUEST_WEB_URL=http://localhost:3200
