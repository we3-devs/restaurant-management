{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/validators/*": ["../../packages/validators/src/*"],
      "@/lib/utils": ["../../packages/ui/src/cn"],
      "@/components/ui/*": ["../../packages/ui/src/*"],
      "@/lib/auth/*": ["../../packages/auth/src/*"],
      "@/lib/server/backend-client": ["../../packages/auth/src/server/backend-client"],
      "@/lib/server/customer-backend-client": ["../../packages/auth/src/server/customer-backend-client"],
      "@/lib/api/*": ["../../packages/api-client/src/*"],
      "@/lib/query-keys": ["../../packages/api-client/src/query-keys"],
      "@/lib/query-config": ["../../packages/api-client/src/query-config"],
      "@/lib/realtime/*": ["../../packages/websocket/src/*"],
      "@/components/providers/query-provider": ["../../packages/api-client/src/query-provider"],
      "@/components/providers/theme-provider": ["../../packages/ui/src/theme-provider"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
