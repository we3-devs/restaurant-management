BACKEND_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=restra.com
# Keep staff cookies host-only so they are never sent to guest subdomains.
# AUTH_COOKIE_DOMAIN=
# Browser-reachable backend origin, used only for the KDS websocket
# connection (the browser can't reach BACKEND_INTERNAL_URL's docker/internal
# hostname, and all other traffic already goes through /api/backend).
NEXT_PUBLIC_BACKEND_WS_URL=http://127.0.0.1:3001

# Where operational-web is deployed — a staff-portal user landing on
# /dashboard gets bounced here (see (dashboard)/layout.tsx).
OPERATIONAL_WEB_URL=http://localhost:3100
# Same value, exposed to the browser — the login form navigates staff users
# straight there (see (auth)/login/login-form.tsx) instead of relying on the
# server-side bounce above, which only fires after an extra round trip.
NEXT_PUBLIC_OPERATIONAL_WEB_URL=http://localhost:3100

# Where guest-web is deployed — QR codes for table ordering point here
NEXT_PUBLIC_GUEST_WEB_URL=http://localhost:3200

# Set to a shared parent domain (e.g. ".example.com") in production so the
# session cookie survives the cross-app redirect above. Leave unset for
# local dev — see packages/auth/src/session.ts.
# AUTH_COOKIE_DOMAIN=.example.com
