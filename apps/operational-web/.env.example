BACKEND_INTERNAL_URL=http://127.0.0.1:3001
# Browser-reachable backend origin, used only for the KDS websocket
# connection (the browser can't reach BACKEND_INTERNAL_URL's docker/internal
# hostname, and all other traffic already goes through /api/backend).
NEXT_PUBLIC_BACKEND_WS_URL=http://127.0.0.1:3001

# Where dashboard-web is deployed — a dashboard-portal user (or superadmin)
# landing on /staff gets bounced here (see staff/layout.tsx).
DASHBOARD_WEB_URL=http://localhost:3000
# Same value, exposed to the browser — the login form navigates dashboard
# users straight there (see (auth)/login/login-form.tsx) instead of relying
# on the server-side bounce above, which only fires after an extra round trip.
NEXT_PUBLIC_DASHBOARD_WEB_URL=http://localhost:3000

# Set to a shared parent domain (e.g. ".example.com") in production so the
# session cookie survives the cross-app redirect above. Leave unset for
# local dev — see packages/auth/src/session.ts. Must match dashboard-web's
# AUTH_COOKIE_DOMAIN exactly.
# AUTH_COOKIE_DOMAIN=.example.com
