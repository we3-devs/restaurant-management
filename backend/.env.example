
PORT=
# Comma-separated list of allowed browser origins (CORS + /kds websocket).
# dashboard-web runs on :3000, operational-web on :3100, guest-web on :3200 in dev — all
# need to be listed or websocket handshakes get CORS-rejected and silently fall back to polling.
FRONTEND_URL=http://localhost:3000,http://localhost:3100,http://localhost:3200

# Absolute base URL this API is reachable at, used to build upload URLs when
# falling back to local disk. Defaults to http://localhost:$PORT.
PUBLIC_API_URL=

# --- Branding image storage (logo/favicon) ---------------------------------
# Any S3-compatible provider. Leave S3_BUCKET empty and uploads go to local
# disk (UPLOAD_DIR, default ./uploads) — fine for dev, but on an ephemeral host
# such as Render every upload is lost on redeploy, so set these in production.
#
# Free tiers that all work here: Cloudflare R2 (10GB, no egress fees),
# Supabase Storage (1GB), Backblaze B2 (10GB).
#
# R2 example:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_URL=https://pub-<hash>.r2.dev      # read host, differs from the API endpoint
#   S3_REGION=auto
UPLOAD_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
BCRYPT_SALT_ROUNDS=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SMTP_HOST=... SMTP_PORT=... SMTP_USER=... SMTP_PASS=... SMTP_FROM=...
TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=... TWILIO_FROM_NUMBER=...
