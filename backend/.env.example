# Backend server
PORT=3001
PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000,http://localhost:3100,http://localhost:3200
OPERATIONAL_WEB_URL=http://localhost:3100
LOG_LEVEL=info

# PostgreSQL / Supabase connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=restaurant
DB_USERNAME=postgres
DB_PASSWORD=

# Authentication — generate unique random values for every environment.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=400d
BCRYPT_SALT_ROUNDS=12

# Optional admin seed account (development only)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Optional branding storage. Local disk is suitable only for development.
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# AI assistant
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
ASSISTANT_CRON_SECRET=

# Optional email, SMS, and web-push integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
