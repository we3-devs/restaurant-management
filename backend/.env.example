API_MODE=normal
PORT=3001

PUBLIC_API_URL=http://localhost:3001

# S3-compatible storage (Supabase Storage, R2, AWS, etc.).
# The bucket must be public if returned URLs are displayed directly.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=branding
S3_ENDPOINT=
S3_REGION=
# Public URL base without the bucket name. Upload keys already include branding/ or food/.
S3_PUBLIC_URL=

# Direct Supabase Storage REST fallback (used only when S3_BUCKET is not configured)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PUBLIC_URL=
# Socket.IO handshake allowlist — every origin that opens a /kds socket.
# staff-web runs on 3000, guest-web on 3200, superadmin-web on 3300; the
# 127.0.0.1 forms are separate origins to a browser, so list both. Omitting
# this falls back to http://localhost:3000 alone, which silently blocks the
# WS handshake everywhere else and makes all realtime look "broken".
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3200,http://127.0.0.1:3200,http://localhost:3300,http://127.0.0.1:3300
OPERATIONAL_WEB_URL=http://localhost:3100
LOG_LEVEL=info

# PostgreSQL / Supabase connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=restaurant
DB_USERNAME=postgres
DB_PASSWORD=

# Authentication — generate unique random values for every environment.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=400d
BCRYPT_SALT_ROUNDS=12

# AI assistant
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ASSISTANT_CRON_SECRET=
