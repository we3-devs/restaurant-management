
PORT=
# Comma-separated list of allowed browser origins (CORS + /kds websocket).
# dashboard-web runs on :3000, operational-web on :3100, guest-web on :3200 in dev — all
# need to be listed or websocket handshakes get CORS-rejected and silently fall back to polling.
FRONTEND_URL=http://localhost:3000,http://localhost:3100,http://localhost:3200

DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
BCRYPT_SALT_ROUNDS=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SMTP_HOST=... SMTP_PORT=... SMTP_USER=... SMTP_PASS=... SMTP_FROM=...
TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=... TWILIO_FROM_NUMBER=...
