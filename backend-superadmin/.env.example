# Dedicated platform administration API
API_MODE=superadmin
PORT=3002
PUBLIC_API_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3300

# Use a different secret from backend/.env.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=400d

# Database connection. Use a database user restricted to platform operations
# in production; do not reuse the normal API credentials.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=restaurant
DB_USERNAME=postgres
DB_PASSWORD=
BCRYPT_SALT_ROUNDS=12

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
